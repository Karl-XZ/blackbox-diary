{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blackbox-diary:claim-candidates:1.1",
  "title": "BlackBox Diary claim candidates V1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_epoch", "candidates"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "content_epoch": {"type": "integer", "minimum": 1},
    "candidates": {
      "type": "array", "maxItems": 64,
      "items": {"$ref": "#/$defs/claim"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "event_revision", "start_cp", "end_cp", "quote", "text_sha256"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "event_revision": {"type": "integer", "minimum": 1},
        "start_cp": {"type": "integer", "minimum": 0},
        "end_cp": {"type": "integer", "minimum": 1},
        "quote": {"type": "string", "minLength": 1, "maxLength": 300},
        "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_index"],
      "properties": {
        "evidence_index": {"type": "integer", "minimum": 0, "maximum": 7}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "claim_type", "template_id", "evidence", "slot_bindings"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
        "claim_type": {
          "enum": ["SCREEN_TEXT_OBSERVED", "AUDIO_TEXT_OBSERVED", "USER_NOTE_REPORTED", "SYSTEM_GAP_RECORDED", "PROCESSING_STATUS"]
        },
        "template_id": {
          "enum": ["screen.quote.v1", "audio.quote.v1", "note.quote.v1", "system.gap.v1", "system.processing.v1"]
        },
        "evidence": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/evidence"}},
        "slot_bindings": {
          "type": "object", "additionalProperties": false,
          "properties": {"quoted_text": {"$ref": "#/$defs/binding"}}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"claim_type": {"enum": ["SCREEN_TEXT_OBSERVED", "AUDIO_TEXT_OBSERVED", "USER_NOTE_REPORTED"]}}},
          "then": {"properties": {"slot_bindings": {"required": ["quoted_text"]}}}
        }
      ]
    }
  }
}
